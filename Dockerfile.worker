# Worker Celery - mesma base do app, comando diferente
FROM python:3.11-slim

WORKDIR /app

RUN apt-get update && apt-get install -y \
    gcc \
    postgresql-client \
    curl \
    && rm -rf /var/lib/apt/lists/*

COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

COPY . .

# Create user for --uid to avoid "running worker with superuser privileges" SecurityWarning
RUN adduser --disabled-password --gecos "" --uid 1000 celeryuser

# Ensure libpq looks for SSL certs in a path readable by celeryuser (fixes "postgresql.crt: Permission denied")
ENV HOME=/home/celeryuser

# Pool de banco POR PROCESSO. Fica na IMAGEM, não no painel: a concorrência de 8
# e o pool menor são a MESMA decisão, e separar as duas em lugares diferentes é
# como alguém sobe uma sem a outra e estoura o Supabase. Aqui elas não têm como
# se desencontrar — e o ambiente ainda pode sobrepor se precisar.
# 8 processos × (2+3) = 40 conexões, o mesmo total de antes (4 × 10).
ENV DB_POOL_SIZE=2 \
    DB_MAX_OVERFLOW=3

# --concurrency EXPLÍCITO: sem a flag o Celery usa o nº de vCPUs (4 no VPS), um
# default pensado para trabalho de CPU. As tasks de envio em grupo fazem o
# oposto — dormem entre mensagens (pausa 8-20s por rodada) e seguram o slot por
# até 15 min. Eram 4 afiliadas enviando por vez, com CSV e Shopee disputando os
# mesmos slots.
#
# ⚠️ Anda junto com o ENV acima: o pool é POR PROCESSO, então 8 processos com o
# default da API (5+5) abririam 80 conexões contra as 40 de hoje e estourariam o
# Supabase antes de o WhatsApp virar gargalo. Mexer numa sem a outra é o erro.
#
# Uma imagem, dois papéis — quem decide é CELERY_SOMENTE_WHATSAPP no ambiente.
# O entrypoint explica os dois e por que o padrão continua sem `-Q`.
# Dois Dockerfiles seria como o worker dedicado fica com código velho: recurso
# separado que ninguém lembra de atualizar (já aconteceu, por semanas).
RUN chmod +x /app/scripts/worker-entrypoint.sh
CMD ["/app/scripts/worker-entrypoint.sh"]
